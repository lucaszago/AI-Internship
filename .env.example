# Local development only — never commit real keys.
# On Databricks Apps, use secret scope week1v2 / key openai_api_key instead.
OPENAI_API_KEY=

# RAG / AI Search (Phase 1) — same names as Phase 0 setup
RAG_CATALOG=workspace
RAG_SCHEMA=document_retrieval
RAG_TABLE=document_chunks
VECTOR_SEARCH_ENDPOINT=document-chunks-search-endpoint
VECTOR_SEARCH_INDEX=workspace.document_retrieval.document_chunks_index
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# Streamlit UI — default is the deployed Databricks App URL
API_URL=https://week1v2-ask-ui-299177927171866.aws.databricksapps.com
# For local API only: API_URL=http://127.0.0.1:8000

# Optional: Databricks Connect profile for local Spark writes (Phase 1.4+)
# DATABRICKS_CONFIG_PROFILE=dbx-lzago-ai
