# Local development only — never commit real keys.
OPENAI_API_KEY=

# Pinecone (Session 2 RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=document-chunks

# Embedding / chunk settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# Streamlit UI — local by default; set to your Render URL after deploy
API_URL=http://127.0.0.1:8000
