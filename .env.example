# Local development only — never commit real keys.
OPENAI_API_KEY=

# Pinecone (Session 2 RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=document-chunks

# Embedding / chunk settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# Streamlit UI — live Render URL by default; use localhost for local API only
API_URL=https://week1v2-ask-api-public.onrender.com
# API_URL=http://127.0.0.1:8000

# Week 3 ADK agent (POST /agent) — also loaded from week3_agent/.env
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.6-flash
AGENT_MAX_STEPS=8
# DB_PATH defaults to week3_agent/data/demo.db
